# ------------------------------------------------------------
# Filter data and remove hypervariable windows
# ------------------------------------------------------------
# - Converts variant counts per 10 kb window to variants per kb
# - Filters out windows with > max_per_kb variants across genomes
# ------------------------------------------------------------

filter_data <- function(df, genomes, max_per_kb) {
  df %>%
    mutate(across(all_of(genomes), ~ .x / 10)) %>% 
    filter(if_all(all_of(genomes), ~ .x <= max_per_kb))
}

# ------------------------------------------------------------
# Compute genome divergence matrix
# ------------------------------------------------------------
# Divergence is calculated as the mean absolute difference
# in variant density between genome pairs.
# ------------------------------------------------------------

compute_divergence <- function(df, genomes) {
  mat <- df %>% select(all_of(genomes)) %>% as.matrix()
  
  divergence <- matrix(
    NA,
    nrow = length(genomes),
    ncol = length(genomes),
    dimnames = list(genomes, genomes)
  )
  
  for (i in seq_along(genomes)) {
    for (j in seq_along(genomes)) {
      divergence[i, j] <- mean(abs(mat[, i] - mat[, j]), na.rm = TRUE)
    }
  }
  
  divergence
}

# ------------------------------------------------------------
# Draw variant density heatmap
# ------------------------------------------------------------
# - Uses log10(variants/kb + 1) scaling
# - Annotates genomic position in Mb
# - Designed for chromosome-level visualization
# ------------------------------------------------------------

draw_heatmap <- function(chr_data_kb, samples) {
  mat <- chr_data_kb %>% select(all_of(samples)) %>% as.matrix()
  mat_log <- log10(mat + 1)
  
  coords_mb <- chr_data_kb$Start / 1e6
  rounded_coords <- round(coords_mb)
  
  label_info <- tibble(
    row = seq_along(rounded_coords),
    Mb  = rounded_coords
  ) %>%
    filter(Mb %% 10 == 0) %>%
    distinct(Mb, .keep_all = TRUE)
  
  mb_axis <- rowAnnotation(
    Mb = anno_mark(
      at = label_info$row,
      labels = paste0(label_info$Mb, " Mb"),
      side = "left",
      labels_gp = gpar(fontsize = 9, col = "black"),
      link_width = unit(5, "mm")
    ),
    width = unit(4.2, "cm")
  )
  
  col_fun <- colorRamp2(
    c(0, 1.04, 1.32, 1.49, 1.61, 1.71),
    c("lightgreen", "purple", "blue", "red", "darkred", "black")
  )
  
  Heatmap(
    mat_log,
    name = "Variants/kb",
    col = col_fun,
    cluster_rows = FALSE,
    cluster_columns = FALSE,
    show_row_names = FALSE,
    left_annotation = mb_axis,
    column_names_rot = 45,
    column_title = paste("Variants per 1 kb –", unique(chr_data_kb$Chrom)),
    heatmap_legend_param = list(
      at = c(0, 1.04, 1.32, 1.49, 1.61, 1.71),
      labels = c("0", "10", "20", "30", "40", "50"),
      direction = "horizontal"
    )
  ) %>% draw(heatmap_legend_side = "bottom")
}
