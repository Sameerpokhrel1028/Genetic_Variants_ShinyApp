#!/usr/bin/env bash
# ============================================================
# Parse pangenome VCF into a sample-wise variant count matrix
# ============================================================
# This script converts a multi-sample pangenome VCF into a
# window-based variant count matrix (e.g. 10 kb windows).
#
# Output:
#   - A TSV file with columns:
#     Chrom | Start | End | Sample1 | Sample2 | ...
#
# Notes:
# - Counts non-reference variants per sample per window
# - Window size can be changed by modifying the -w parameter
# - Designed as upstream preprocessing for visualization
#   (e.g. Shiny apps, heatmaps, clustering)
#
# Requirements:
#   bcftools >= 1.18
#   bedtools >= 2.31
#
# ============================================================

set -euo pipefail

# ---------------- User inputs ----------------

VCF="peanutpan.vcf.phased.gz"
WINDOW_SIZE=10000
OUT="samplewise_variant_matrix_10kb.tsv"

# ---------------- Load tools -----------------
# (Comment out if tools are already in PATH)

module purge
module load BCFtools/1.18-GCC-12.3.0
module load BEDTools/2.31.1-GCC-13.3.0

# ---------------- Step 1: Genome file from VCF ----------------

bcftools view -h "$VCF" \
  | awk -F'[=,]' '/^##contig=/{for(i=1;i<=NF;i++){if($i=="ID"){id=$(i+1)}; if($i=="length"){len=$(i+1)}}; print id"\t"len}' \
  > contigs.genome

# ---------------- Step 2: Create windows ----------------

bedtools makewindows -g contigs.genome -w "$WINDOW_SIZE" > genome_windows.bed

# ---------------- Step 3: Sample list ----------------

bcftools query -l "$VCF" > sample_list.txt

# ---------------- Step 4: Per-sample variant counts ----------------

rm -f counts_files.txt

while read -r SAMPLE; do
  echo "Processing $SAMPLE"

  # Extract non-reference variant positions for this sample
  bcftools query -s "$SAMPLE" -f '%CHROM\t%POS\t[%GT]\n' "$VCF" \
    | awk '$3 ~ /(^|[\/|])[1-9]/ {print $1, $2-1, $2}' OFS="\t" \
    > "${SAMPLE}.bed"

  # Count variants per window
  bedtools coverage -a genome_windows.bed -b "${SAMPLE}.bed" -counts \
    | cut -f4 > "${SAMPLE}_counts.tsv"

  echo "${SAMPLE}_counts.tsv" >> counts_files.txt
  rm -f "${SAMPLE}.bed"
done < sample_list.txt

# ---------------- Step 5: Assemble matrix ----------------

{
  printf "Chrom\tStart\tEnd"
  while read -r SAMPLE; do printf "\t%s" "$SAMPLE"; done < sample_list.txt
  printf "\n"
} > "$OUT"

paste genome_windows.bed $(cat counts_files.txt) >> "$OUT"

# ---------------- Cleanup ----------------

rm -f contigs.genome genome_windows.bed sample_list.txt counts_files.txt *_counts.tsv

echo "Done. Output written to: $OUT"
